{
  "name": "@nirelc/microtype",
  "description": "Super lightweight and simple type system library",
  "author": "Toil",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/nirelc/microtype#readme",
  "bugs": {
    "url": "https://github.com/nirelc/microtype/issues"
  },
  "keywords": [
    "type",
    "system",
    "type-system",
    "typings",
    "fast",
    "lightweight",
    "lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "publint": "^0.3.23",
    "tsdown": "^0.22.14",
    "typescript": "^7"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./type-system": {
      "types": "./dist/type-system/index.d.mts",
      "import": "./dist/type-system/index.mjs"
    },
    "./type-system/*": {
      "types": "./dist/type-system/*.d.mts",
      "import": "./dist/type-system/*.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:bun": "bunx tsdown"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "./dist"
  ],
  "sideEffects": false
}
